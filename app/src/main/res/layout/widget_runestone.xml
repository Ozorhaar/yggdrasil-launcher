<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/stone_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/runestone_bg"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingTop="10dp"
        android:paddingBottom="8dp">

        <TextClock
            android:id="@+id/stone_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/yggdrasil_runic"
            android:format12Hour="h:mm"
            android:format24Hour="HH:mm"
            android:includeFontPadding="false"
            android:shadowColor="#CC000000"
            android:shadowRadius="6"
            android:textColor="#ECD08F"
            android:textSize="54sp" />

        <TextView
            android:id="@+id/stone_day"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/yggdrasil_runic"
            android:includeFontPadding="false"
            android:paddingTop="2dp"
            android:textColor="#E8DCC4"
            android:textSize="17sp" />

        <ImageView
            android:layout_width="180dp"
            android:layout_height="8dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="5dp"
            android:scaleType="fitXY"
            android:src="@drawable/rune_divider"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/stone_weather"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/yggdrasil_runic"
            android:includeFontPadding="false"
            android:textColor="#8FC4E0"
            android:textSize="15sp" />
    </LinearLayout>
</FrameLayout>
