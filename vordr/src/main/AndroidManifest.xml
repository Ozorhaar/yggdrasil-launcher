<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- To see every app and what it holds (read-only). -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" tools:ignore="QueryAllPackagesPermission" />
    <!-- The weekly look, and a notice when something new turns up. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- New warnings are handed to the Yggdrasil launcher, which passes them to Home Assistant; only
         apps signed with the Yggdrasil key hold this. Declared here too so install order doesn't matter. -->
    <permission android:name="com.ozorhaar.yggdrasil.permission.REPORT" android:protectionLevel="signature" />
    <uses-permission android:name="com.ozorhaar.yggdrasil.permission.REPORT" />
    <!-- Vörðr itself still never touches the network. -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />

    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/no_backup"
        android:icon="@drawable/ic_vordr"
        android:roundIcon="@drawable/ic_vordr"
        android:label="Vörðr"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
        tools:ignore="DataExtractionRules">

        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".Watch"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
    </application>
</manifest>
